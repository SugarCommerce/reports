{
  "name": "sugarcommerce/reports",
  "description": "A reports screen for a WordPress plugin, from a description of what to show: a date range with comparison periods, headline tiles, charts, funnels, tables and progress bars, refreshed in place, with CSV exports that do not time out.",
  "homepage": "https://github.com/SugarCommerce/reports",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "keywords": [
    "wordpress",
    "reports",
    "analytics",
    "charts",
    "tiles",
    "funnel",
    "csv-export",
    "admin",
    "dashboard"
  ],
  "repositories": [
    {
      "type": "path",
      "url": "../dates",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../fields",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../geo",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../money",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../plugin",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../text",
      "options": {
        "symlink": false
      }
    },
    {
      "type": "path",
      "url": "../security",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "php": ">=8.3",
    "sugarcommerce/dates": "dev-main",
    "sugarcommerce/fields": "dev-main",
    "sugarcommerce/money": "dev-main",
    "sugarcommerce/plugin": "dev-main",
    "sugarcommerce/text": "dev-main"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload": {
    "psr-4": {
      "SugarCommerce\\Reports\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\Reports\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php",
      "/tests/stubs.php",
      "/tests/stubs/",
      "/tests/SelfReferences.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist",
    "docs:verify": "php vendor/sugarcommerce/fields/bin/verify-docs.php --calls=Reports::register README.md",
    "test:js": "npm run test:js",
    "test:all": [
      "@test",
      "@test:js"
    ]
  },
  "support": {
    "issues": "https://github.com/SugarCommerce/reports/issues",
    "source": "https://github.com/SugarCommerce/reports"
  }
}
